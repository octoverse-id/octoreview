# Production settings for deploy/docker/compose.yaml (copy to deploy/docker/.env, chmod 600).
# .env.example at the repository root explains every variable; this file holds the ones a
# production host must set. Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=reviews.example.com,127.0.0.1
OCTOREVIEW_SERVICE_TOKEN_PEPPER=
# Never rotates: erased authors are recorded by its HMAC.
OCTOREVIEW_ERASURE_HMAC_KEY=

# PostgreSQL: the "db" service. POSTGRES_PASSWORD is read by compose for the db container and
# must match the password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://octoreview:CHANGE_ME@db:5432/octoreview

# Storage (docs/storage.md). s3 for AWS S3 or an S3-compatible store; local keeps media on this
# host's `media` volume.
OCTOREVIEW_STORAGE_BACKEND=s3
OCTOREVIEW_STORAGE_LOCATION_ID=aws-ap-southeast-3-reviews
OCTOREVIEW_STORAGE_S3_BUCKET=reviews-media
OCTOREVIEW_STORAGE_S3_REGION=ap-southeast-3
# With the s3 backend and no instance role, the boto3 chain reads these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# With OCTOREVIEW_STORAGE_BACKEND=local instead:
# OCTOREVIEW_PUBLIC_BASE_URL=https://reviews.example.com
# OCTOREVIEW_MEDIA_ROOT=/var/lib/octoreview/media
# OCTOREVIEW_MEDIA_TOKEN_SECRET=
OCTOREVIEW_MEDIA_CORS_ORIGINS=https://shop.example.com

# Outbox delivery (docs/events.md).
OCTOREVIEW_OUTBOX_TRANSPORT=webhook
OCTOREVIEW_WEBHOOK_URL=https://hooks.example.com/octoreview
OCTOREVIEW_WEBHOOK_SECRET=

OCTOREVIEW_ADMIN_ENABLED=false
OCTOREVIEW_LOG_LEVEL=INFO
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
