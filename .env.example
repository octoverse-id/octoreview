# Octoreview settings. Every variable the server reads is listed here with its default.
# docs/spec.md section 15 is the reference; a missing required value fails boot with a message
# naming the variable and the fix.

# --- Django -------------------------------------------------------------------------------------
# Debug mode. Never true in production. With it on, DJANGO_SECRET_KEY and the secrets marked
# "DEBUG fallback" below fall back to fixed development values.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# Comma-separated host names; required when DJANGO_DEBUG is false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Database URL. Default: SQLite in the project directory. Production uses PostgreSQL.
DATABASE_URL=postgres://octoreview:octoreview@localhost:5432/octoreview
# Persistent connection lifetime in seconds.
DATABASE_CONN_MAX_AGE=60

# --- Secrets ------------------------------------------------------------------------------------
# Pepper for service-key hashes. Changing it invalidates every issued key. DEBUG fallback.
OCTOREVIEW_SERVICE_TOKEN_PEPPER=
# Erasure pseudonymisation key. Never rotate it: erasure re-runs match the erased form.
# DEBUG fallback.
OCTOREVIEW_ERASURE_HMAC_KEY=

# --- Outbox and webhooks ------------------------------------------------------------------------
# logging (default, logs the event envelope only) or webhook.
OCTOREVIEW_OUTBOX_TRANSPORT=logging
# Required for the webhook transport.
OCTOREVIEW_WEBHOOK_URL=
OCTOREVIEW_WEBHOOK_SECRET=
OCTOREVIEW_WEBHOOK_TIMEOUT_SECONDS=10
OCTOREVIEW_OUTBOX_MAX_ATTEMPTS=5
OCTOREVIEW_OUTBOX_RETRY_BASE_SECONDS=30
OCTOREVIEW_OUTBOX_RETRY_MAX_SECONDS=3600
# Must be greater than the webhook timeout.
OCTOREVIEW_OUTBOX_CLAIM_TIMEOUT_SECONDS=60

# --- Errors and logging -------------------------------------------------------------------------
# Base URL of docs/errors.md; error responses link to <base>#<code>.
OCTOREVIEW_ERROR_DOC_BASE_URL=https://github.com/octoverse-id/octoreview/blob/main/docs/errors.md
OCTOREVIEW_LOG_LEVEL=INFO

# --- Media policy (docs/spec.md section 6.1) ----------------------------------------------------
# Server defaults, used when neither the entity nor the application sets a value.
OCTOREVIEW_DEFAULT_MAX_IMAGES=5
OCTOREVIEW_DEFAULT_MAX_VIDEOS=1
OCTOREVIEW_DEFAULT_MAX_IMAGE_BYTES=10485760
OCTOREVIEW_DEFAULT_MAX_VIDEO_BYTES=104857600
# Ceilings bound every default, application setting and entity override.
OCTOREVIEW_MAX_IMAGES_CEILING=20
OCTOREVIEW_MAX_VIDEOS_CEILING=5
OCTOREVIEW_MAX_IMAGE_BYTES_CEILING=52428800
OCTOREVIEW_MAX_VIDEO_BYTES_CEILING=524288000

# --- Storage (docs/spec.md sections 7 and 15) ---------------------------------------------------
# local (development, single node) or s3 (AWS S3 and S3-compatible stores; docs/storage.md).
# azure and gcs arrive in release line 2.
OCTOREVIEW_STORAGE_BACKEND=local
# A stable id for this bucket or directory. Never reuse it for a different store.
OCTOREVIEW_STORAGE_LOCATION_ID=local-dev
# Absolute base URL of this server; local upload and download URLs are built on it.
OCTOREVIEW_PUBLIC_BASE_URL=http://localhost:8000
# Writable directory for the local backend (development and single-node only).
OCTOREVIEW_MEDIA_ROOT=./var/media
# Signs local upload and download URLs. DEBUG fallback. Generate as DJANGO_SECRET_KEY.
OCTOREVIEW_MEDIA_TOKEN_SECRET=
# Set during a rotation: URLs signed with the previous secret keep working until they expire.
OCTOREVIEW_MEDIA_TOKEN_SECRET_PREVIOUS=
# Optional CDN base for publicly visible media; public URLs become <base>/<storage key>.
OCTOREVIEW_MEDIA_PUBLIC_BASE_URL=
# Comma-separated browser origins allowed to PUT and GET media. The local URLs answer CORS for
# them; on s3 the bucket's CORS rule must allow them, and check_storage verifies it.
OCTOREVIEW_MEDIA_CORS_ORIGINS=http://localhost:3000
# Cross-Origin-Resource-Policy on local media: cross-origin, same-site or same-origin.
OCTOREVIEW_MEDIA_CORP=cross-origin

# --- s3 backend (docs/storage.md; install with `uv sync --extra s3`) -----------------------------
# Credentials come from the boto3 default chain (IRSA, an instance role, or AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY), never from octoreview settings.
# Required with OCTOREVIEW_STORAGE_BACKEND=s3.
OCTOREVIEW_STORAGE_S3_BUCKET=
OCTOREVIEW_STORAGE_S3_REGION=
# Unset for AWS S3; the store's URL for an S3-compatible store.
OCTOREVIEW_STORAGE_S3_ENDPOINT_URL=
# The host presigned URLs are signed for, when clients reach the store by another name than this
# server does (a compose service). Defaults to the endpoint.
OCTOREVIEW_STORAGE_S3_PUBLIC_ENDPOINT_URL=
# auto, path or virtual; path for a store reached by a bare host name.
OCTOREVIEW_STORAGE_S3_ADDRESSING_STYLE=auto

# --- Media URLs and completion ------------------------------------------------------------------
# Lifetime of upload URLs and of signed download URLs, in seconds (minimum 60).
OCTOREVIEW_UPLOAD_URL_TTL_SECONDS=900
OCTOREVIEW_MEDIA_URL_TTL_SECONDS=900
# How long one `complete` call holds its lease before another may take over.
OCTOREVIEW_COMPLETE_LEASE_SECONDS=900
# Completions validating at once per process; more get 503 too_many_completions.
OCTOREVIEW_MAX_CONCURRENT_COMPLETIONS=4
# Media embedded per review in list and detail responses; GET /reviews/{id}/media returns all.
OCTOREVIEW_LIST_MEDIA_LIMIT=10
# Signed download URLs cached per worker process for one signing epoch (TTL/2); 0 turns it off.
# Each entry is one URL, under 1 KiB.
OCTOREVIEW_MEDIA_URL_CACHE_SIZE=10000

# --- Gunicorn (the container image; docs/deployment.md) -----------------------------------------
# Worker processes, about 2 x cores + 1.
WEB_CONCURRENCY=2
# gthread keeps workers alive while threads wait on storage; keep the thread count above
# OCTOREVIEW_MAX_CONCURRENT_COMPLETIONS.
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=8
# Heartbeat timeout (not a request limit under gthread) and the drain window on shutdown.
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=25
# Off by default: the app logs every request with its route template. When on, it is scrubbed JSON.
GUNICORN_ACCESS_LOG=

# --- Admin console (docs/operations.md "Admin console") ------------------------------------------
# Mounts the superuser-only operator console at /admin/. Off in the image, on in compose.
OCTOREVIEW_ADMIN_ENABLED=false
